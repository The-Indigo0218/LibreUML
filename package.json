{
  "name": "libreuml-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev:modeler": "turbo run dev --filter=@libreuml/modeler",
    "dev:academy": "turbo run dev --filter=@libreuml/academy",
    "electron:dev": "turbo run electron:dev --filter=@libreuml/modeler",
    "dist": "turbo run dist --filter=@libreuml/modeler"
  },
  "devDependencies": {
    "turbo": "^2.9.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.6.2"
}
